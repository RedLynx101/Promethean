# GitHub Issue Triage — required secrets
# ==========================================================================
# Copy to `.env` and fill in real values for live operation. The smoke test
# (`pnpm test`) runs hermetic with stub fixtures and does not require any of
# these to be set.

# Anthropic — for classify-1 (L2 via small-context prompt) and draft-response-1 (L3)
ANTHROPIC_API_KEY=

# GitHub — for webhook verify, label PUT, team assign, comment PATCH
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_USER_ID=

# PagerDuty — for page-oncall-1 (security branch only)
PAGERDUTY_ROUTING_KEY=

# Slack — for security-gate-1 (approval surface) and alert fan-out
SLACK_WEBHOOK_URL=
SLACK_APPROVAL_CHANNEL_ID=

# Toggle real external calls on/off.
#   - "false" (default): classify/draft/page stub to deterministic fixtures.
#   - "true": nodes actually hit Anthropic / GitHub / PagerDuty.
LIVE=false

# Port for the Express webhook receiver.
PORT=3000
