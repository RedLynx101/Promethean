{
  "name": "github-issue-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emit output from Promethean for the GitHub Issue Triage workflow (langgraph-js target).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps ./dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^2.0.0"
  }
}
