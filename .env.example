# Pass settings to the server process; files are not loaded automatically.
# Keep the secret outside the repository. Configure either KEY or KEY_FILE.
# OPENAI_API_KEY_FILE=C:/path/to/private-key.txt
# OPENAI_API_KEY=
PROMETHEAN_MODEL=gpt-5.6-luna
PROMETHEAN_BUDGET_USD=5
PROMETHEAN_DATA_DIR=work/data
PROMETHEAN_HOST=127.0.0.1
PROMETHEAN_API_PORT=4318
# Remote binding requires an access token and further hosting work.
# PROMETHEAN_ACCESS_TOKEN=
