{
  "name": "promethean-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node tooling/dev.mjs",
    "start": "node --import tsx apps/api/src/index.ts",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "format": "prettier --write apps packages tooling docs .github tests .agents README.md CONTRIBUTING.md SECURITY.md AI_USAGE.md *.json *.ts *.mjs *.yaml",
    "format:check": "prettier --check apps packages tooling docs .github tests .agents README.md CONTRIBUTING.md SECURITY.md AI_USAGE.md *.json *.ts *.mjs *.yaml",
    "promethean": "tsx packages/cli/src/index.ts",
    "lint": "eslint apps packages tooling tests *.ts *.mjs",
    "test:live": "tsx apps/api/src/live-verify.ts",
    "demo": "tsx tooling/demo.ts",
    "verify:examples": "tsx tooling/verify-examples.ts",
    "verify:packages": "tsx tooling/verify-packages.ts",
    "capture:showcase": "tsx tooling/capture-showcase.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
